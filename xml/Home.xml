	<onload>ClearProperty(bp.rowmenu.title.rep)</onload>
	<onload>ClearProperty(bp.rscan)</onload>
	<onload>ClearProperty(bp.rscan.idx)</onload>
	<onload>ClearProperty(bp.rscan.fn)</onload>
	<onload>ClearProperty(bp.rscan.code)</onload>
	<onload>ClearProperty(bp.rscan.display)</onload>
