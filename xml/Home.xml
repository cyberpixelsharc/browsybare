	<onload>ClearProperty(bp.notice.line)</onload>
	<onload>ClearProperty(bp.kb)</onload>
	<onload>ClearProperty(bp.aload)</onload>
	<onload>ClearProperty(bp.aload.t)</onload>
	<onload>ClearProperty(bp.exit)</onload>
	<!-- Single serial boot (sync, drives, rows, accents, daemons). Parallel
	     RunScripts segfaulted Kodi at interpreter startup. -->
	<onload condition="String.IsEmpty(Skin.String(accent))">Skin.SetString(accent,FF8EB7D7)</onload>
	<onload>SetProperty(bp.accent.value,$INFO[Skin.String(accent)])</onload>
	<onload condition="String.IsEmpty(Skin.String(accent.level))">Skin.SetString(accent.level,L3)</onload>
	<onload>SetProperty(bp.accent.level,$INFO[Skin.String(accent.level)])</onload>
	<onload condition="String.IsEmpty(Skin.String(guisound.level))">Skin.SetString(guisound.level,4)</onload>
	<onload>SetProperty(bp.guisound.level,$INFO[Skin.String(guisound.level)])</onload>
	<onload condition="String.IsEmpty(Skin.String(sort))">Skin.SetString(sort,name)</onload>
	<onload>RunScript(special://skin/scripts/boot.py)</onload>
	<!-- No window-level onback (ignored); overlay close plus focus restore live
	     on each control, file-manager Back is the keymap dispatcher. -->
	<defaultcontrol always="true">30</defaultcontrol>
	<backgroundcolor>bp_bg</backgroundcolor>
	<controls>
		<control type="label">
			<visible>String.IsEqual(Window(10000).Property(bp.status), error)</visible>
			<left>80</left>
			<top>80</top>
			<width>1760</width>
			<height>60</height>
			<font>font13</font>
			<align>left</align>
			<aligny>center</aligny>
			<textcolor>bp_error</textcolor>
			<label>$LOCALIZE[31303]: $INFO[Window(10000).Property(bp.error)]</label>
		</control>
	<!-- Fullscreen install veil (bp.sync.active): nothing reachable until the
	     base layer lands; gone after the reload. -->
	<!-- File manager hidden until boot sets bp.ready (Home paints before scripts
	     run); the error label always shows. -->
		<control type="group">
			<visible>String.IsEqual(Window(10000).Property(bp.ready),1)</visible>
			<include content="Layout"/>
		</control>
		<control type="group">
			<visible>String.IsEqual(Window(10000).Property(bp.sync.active),1)</visible>
