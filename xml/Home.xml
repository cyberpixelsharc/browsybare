	<onload>ClearProperty(bp.menu)</onload>
	<onload>ClearProperty(bp.drives)</onload>
	<onload>ClearProperty(bp.ctx)</onload>
	<onload>ClearProperty(bp.ctx.reduced)</onload>
	<onload>ClearProperty(bp.ctx.net)</onload>
	<onload>ClearProperty(bp.ctx.readonly)</onload>
	<onload>ClearProperty(bp.rowmenu)</onload>
