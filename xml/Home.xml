<?xml version="1.0" encoding="UTF-8"?>
<!-- File manager shell: onloads plus error path. Layout lives in Layout.xml. -->
<window>
	<!-- Transient overlay states are cleared on load (a persisted property would
	     resurrect a ghost overlay without focus). -->
