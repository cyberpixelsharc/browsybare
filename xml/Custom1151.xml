		<!-- Loading spinner (bp.photo.loading): the viewer opens with an empty
		     texture while the first image is downloaded and scaled (network
		     sources take seconds), so this covers the otherwise black phase.
		     Drawn after the OSD, before the InfoOverlay. -->
		<control type="group">
			<visible>String.IsEqual(Window(10000).Property(bp.photo.loading),1)</visible>
			<animation effect="fade" start="0" end="100" time="120">Visible</animation>
			<control type="image">
