		<!-- Loading spinner: covers the black phase while the first image downloads. Drawn after the OSD, before the InfoOverlay. -->
		<control type="group">
			<visible>String.IsEqual(Window(10000).Property(bp.photo.loading),1)</visible>
			<animation effect="fade" start="0" end="100" time="120">Visible</animation>
			<control type="image">
				<left>924</left>
				<top>568</top>
				<width>72</width>
				<height>72</height>
				<animation effect="rotate" end="-360" center="auto" time="1200" loop="true" reversible="false" condition="true">Conditional</animation>
				<texture colordiffuse="$INFO[Skin.String(accent)]">osd/arrow-clockwise.png</texture>
			</control>
		</control>
		<include>InfoOverlay</include>
	</controls>
</window>
