<?xml version="1.0" encoding="UTF-8"?>
<!-- Photo viewer window (id 1151): own fullscreen window so Ken Burns
     animates without re-rendering the Home file manager underneath.
     The file MUST be named Custom1151.xml: Kodi registers custom windows
     by file name, a free id inside is not enough ("Unable to locate
     window" otherwise). Opened via ActivateWindow(1151) from
     fileops.photo_open, closed via photoclose (ActivateWindow(Home)).
     Carries its own InfoOverlay for the photo EXIF modal. -->
<window id="1151">
	<defaultcontrol>901</defaultcontrol>
	<onback>RunScript(special://skin/scripts/main.py,photoclose)</onback>
	<controls>
			<control type="button" id="899">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>1080</height>
				<texturefocus colordiffuse="FF000000">drawn/fill.png</texturefocus>
				<texturenofocus colordiffuse="FF000000">drawn/fill.png</texturenofocus>
				<onclick condition="String.IsEqual(Window(10000).Property(bp.photo.osd),1)">RunScript(special://skin/scripts/main.py,photoclose)</onclick>
				<onclick condition="!String.IsEqual(Window(10000).Property(bp.photo.osd),1)">RunScript(special://skin/scripts/main.py,photoshow)</onclick>
				<onback>RunScript(special://skin/scripts/main.py,photoclose)</onback>
			</control>
			
			<control type="image">
				<visible>String.IsEqual(Window(10000).Property(bp.photo),open) + String.IsEqual(Window(10000).Property(bp.photo.mode),0)</visible>
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>1080</height>
				<aspectratio>keep</aspectratio>
				<fadetime>800</fadetime>
				<texture>$INFO[Window(10000).Property(bp.photo.path)]</texture>
			</control>
			<control type="image">
				<visible>String.IsEqual(Window(10000).Property(bp.photo),open) + String.IsEqual(Window(10000).Property(bp.photo.mode),1)</visible>
