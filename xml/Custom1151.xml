				<height>1080</height>
				<aspectratio>scale</aspectratio>
				<fadetime>800</fadetime>
				<texture>$INFO[Window(10000).Property(bp.photo.path)]</texture>
			</control>
			<control type="image">
				<visible>String.IsEqual(Window(10000).Property(bp.photo),open) + String.IsEqual(Window(10000).Property(bp.photo.mode),2)</visible>
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>1080</height>
				<aspectratio>scale</aspectratio>
				<fadetime>800</fadetime>
				<texture>$INFO[Window(10000).Property(bp.photo.path)]</texture>
				<!-- Ken Burns: one control, four bp.photo.kb corner variants panning centre
				     to corner and back. Switching at the centre is seamless;
				     reversible=false stops a lost variant instead of rewinding it. -->
				<animation type="Conditional" condition="String.IsEqual(Window(10000).Property(bp.photo),open) + String.IsEqual(Window(10000).Property(bp.photo.mode),2) + String.IsEqual(Window(10000).Property(bp.photo.kb),0)" reversible="false" pulse="true">
					<effect type="zoom" start="108" end="116" time="12000" center="auto" tween="sine" easing="inout" />
					<effect type="slide" start="0,0" end="30,18" time="12000" tween="sine" easing="inout" />
				</animation>
				<animation type="Conditional" condition="String.IsEqual(Window(10000).Property(bp.photo),open) + String.IsEqual(Window(10000).Property(bp.photo.mode),2) + String.IsEqual(Window(10000).Property(bp.photo.kb),1)" reversible="false" pulse="true">
					<effect type="zoom" start="108" end="116" time="12000" center="auto" tween="sine" easing="inout" />
					<effect type="slide" start="0,0" end="30,-18" time="12000" tween="sine" easing="inout" />
				</animation>
				<animation type="Conditional" condition="String.IsEqual(Window(10000).Property(bp.photo),open) + String.IsEqual(Window(10000).Property(bp.photo.mode),2) + String.IsEqual(Window(10000).Property(bp.photo.kb),2)" reversible="false" pulse="true">
					<effect type="zoom" start="108" end="116" time="12000" center="auto" tween="sine" easing="inout" />
					<effect type="slide" start="0,0" end="-30,-18" time="12000" tween="sine" easing="inout" />
				</animation>
				<animation type="Conditional" condition="String.IsEqual(Window(10000).Property(bp.photo),open) + String.IsEqual(Window(10000).Property(bp.photo.mode),2) + String.IsEqual(Window(10000).Property(bp.photo.kb),3)" reversible="false" pulse="true">
					<effect type="zoom" start="108" end="116" time="12000" center="auto" tween="sine" easing="inout" />
					<effect type="slide" start="0,0" end="-30,18" time="12000" tween="sine" easing="inout" />
				</animation>
			</control>
