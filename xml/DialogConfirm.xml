<?xml version="1.0" encoding="UTF-8"?>
<!-- Confirm dialog: dark panel (control ids mandated). Ours permanently, never replaced by sync. Opaque accent focus (store may be empty). -->
<window>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>760</width>
			<height>300</height>
			<control type="image">
				<width>760</width>
				<height>300</height>
				<texture border="24" colordiffuse="$INFO[Window(10000).Property(bp.theme.panel)]">drawn/panel.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>760</width>
				<height>60</height>
				<texture border="24" colordiffuse="$INFO[Window(10000).Property(bp.theme.header)]">drawn/header.png</texture>
			</control>
			<control type="label" id="1">
				<left>0</left>
				<top>2</top>
				<width>760</width>
				<height>60</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font25_title</font>
				<textcolor>$INFO[Window(10000).Property(bp.theme.text)]</textcolor>
			</control>
			<!-- Click absorber: transparent image, never a button (a button would steal focus on mouse move). -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>760</width>
				<height>300</height>
				<texture>drawn/blank.png</texture>
			</control>
			<control type="textbox" id="9">
				<left>40</left>
				<top>83</top>
				<width>680</width>
				<height>110</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font13</font>
				<textcolor>$INFO[Window(10000).Property(bp.theme.text2)]</textcolor>
				<wrap>multi</wrap>
			</control>
			<control type="progress" id="20">
				<left>40</left>
				<top>205</top>
				<width>680</width>
				<height>6</height>
				<texturesliderbackground colordiffuse="$INFO[Window(10000).Property(bp.theme.raised2)]">drawn/white.png</texturesliderbackground>
				<textureslidernib colordiffuse="FF8EB7D7">drawn/white.png</textureslidernib>
				<visible>!String.IsEmpty(Control.GetLabel(20))</visible>
			</control>
			<control type="grouplist">
				<orientation>horizontal</orientation>
				<align>center</align>
				<itemgap>16</itemgap>
				<top>216</top>
				<left>0</left>
				<width>760</width>
			<control type="button" id="11">
				<width>200</width>
				<height>60</height>
				<font>font13</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>$INFO[Window(10000).Property(bp.theme.text)]</textcolor>
				<focusedcolor>FF8EB7D7</focusedcolor>
				<texturefocus border="18" colordiffuse="$INFO[Window(10000).Property(bp.theme.raised3)]">drawn/row.png</texturefocus>
				<texturenofocus border="18" colordiffuse="$INFO[Window(10000).Property(bp.theme.row)]">drawn/row.png</texturenofocus>
			</control>
			<control type="button" id="10">
				<width>200</width>
				<height>60</height>
				<font>font13</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>$INFO[Window(10000).Property(bp.theme.text)]</textcolor>
				<focusedcolor>FF8EB7D7</focusedcolor>
				<texturefocus border="18" colordiffuse="$INFO[Window(10000).Property(bp.theme.raised3)]">drawn/row.png</texturefocus>
				<texturenofocus border="18" colordiffuse="$INFO[Window(10000).Property(bp.theme.row)]">drawn/row.png</texturenofocus>
			</control>
				<control type="button" id="12">
					<width>200</width>
					<height>60</height>
					<font>font13</font>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>$INFO[Window(10000).Property(bp.theme.text)]</textcolor>
					<focusedcolor>FF8EB7D7</focusedcolor>
					<texturefocus border="18" colordiffuse="$INFO[Window(10000).Property(bp.theme.raised3)]">drawn/row.png</texturefocus>
					<texturenofocus border="18" colordiffuse="$INFO[Window(10000).Property(bp.theme.row)]">drawn/row.png</texturenofocus>
					<visible>!String.IsEmpty(Control.GetLabel(12))</visible>
				</control>
			</control>
		</control>
	</controls>
</window>
