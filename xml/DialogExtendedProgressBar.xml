	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>760</width>
			<height>200</height>
			<control type="image">
				<width>760</width>
				<height>200</height>
				<colordiffuse>bp_bar</colordiffuse>
				<texture>drawn/white.png</texture>
			</control>
			<control type="textbox" id="9">
