<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen audio visualisation. Window 12006 is the core's Backspace/SwitchToFullScreen
     target. With the "Fullscreen visualisation" setting ON it shows Kodi's active
     visualisation add-on (projectM, milkdrop, shadertoy, spectrum, waveform, ...); with the
     setting OFF (default) the onloads keep the old behaviour: Backspace during audio stops
     playback and returns Home. Back closes it. -->
<window>
	<defaultcontrol></defaultcontrol>
	<onload condition="!Skin.HasSetting(audio.visualisation)">PlayerControl(Stop)</onload>
	<onload condition="!Skin.HasSetting(audio.visualisation)">ActivateWindow(Home)</onload>
	<controls>
		<control type="visualisation" id="2">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<bottom>0</bottom>
			<visible>Visualisation.Enabled</visible>
		</control>
		<!-- Touch: tapping the screen closes the visualisation and returns to the file manager (touch devices have no Back/ESC). -->
		<control type="button" id="3">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<bottom>0</bottom>
			<texturefocus />
			<texturenofocus />
			<onclick>ActivateWindow(Home)</onclick>
		</control>
	</controls>
</window>
