				<aligny>center</aligny>
				<font>font13</font>
				<textcolor>$INFO[Window(10000).Property(bp.theme.text2)]</textcolor>
				<focusedcolor>$INFO[Skin.String(accent)]</focusedcolor>
				<texturefocus border="18" colordiffuse="$INFO[Window(10000).Property(bp.accent.hov)]">drawn/row.png</texturefocus>
