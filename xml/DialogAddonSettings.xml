			</control>
			<!-- Click absorber over the panel. -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1820</width>
				<height>900</height>
				<texture>drawn/blank.png</texture>
			</control>
			<control type="grouplist" id="3">
				<left>29</left>
				<top>80</top>
				<width>400</width>
				<height>600</height>
				<orientation>vertical</orientation>
				<itemgap>4</itemgap>
				<onleft>9000</onleft>
				<onright>5</onright>
				<onup>20</onup>
				<ondown>20</ondown>
