<?xml version="1.0" encoding="UTF-8"?>
<!-- Our own add-on settings dialog (Kodi's CGUIDialogSettingsBase, e.g. the
     visualisation settings reached with V): Browsybare container look. Control
     ids are mandated by GUIDialogSettingsBase.h/.cpp: title 2, categories 3,
     settings 5, description 6, templates 7-15, buttons 28/29/30. The setting
     rows reuse Estuary's DefaultSettingButton/DefaultSettingLabel (already
     accent-themed). Protected (OUR_XML), never replaced by sync. -->
<window>
	<defaultcontrol>5</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<bottom>0</bottom>
			<texture colordiffuse="$INFO[Window(10000).Property(bp.theme.veil)]">drawn/fill.png</texture>
		</control>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1820</width>
			<height>900</height>
			<control type="image">
				<width>1820</width>
				<height>900</height>
				<texture border="24" colordiffuse="$INFO[Window(10000).Property(bp.theme.panel)]">drawn/panel.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1820</width>
				<height>60</height>
