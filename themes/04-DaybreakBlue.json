{
  // DaybreakBlue
  "colors": {
	"bg": "FF0F1D33",           // window + file-list background
	"panel": "FF182C48",        // menus, dialogs and panels
	"panel_solid": "F2182C48",  // top bar, photo OSD, audio footer
	"panel_solid2": "FC182C48", // video OSD sheet
	"row": "FF132339",          // chip / button backgrounds (drive, breadcrumb)
	"zebra": "FF182C48",        // list stripe (every other row; == panel_solid)
	"header": "FF24405F",       // top-bar separator + dialog headers
	"raised": "FF2D4B6D",       // raised small elements
	"raised2": "FF223A57",      // scrollbar
	"raised3": "FF27425F",      // extra small elements
	"surface": "FF1F3753",      // modal surfaces
	"divider": "26B5D6F0",      // thin separator (alpha 0x26)
	"divider2": "33B5D6F0",     // stronger separator (alpha 0x33)
	"veil": "80070E1A",         // dim backdrop behind menus (alpha 0x80)
	"text": "FFEAF3FB",         // primary text
	"text2": "FFB5D6F0",        // list / secondary text
	"muted": "FF6F8CA8",        // faint text
	"control": "FF3E5A7A"       // off/inactive controls (row + one step lighter)
