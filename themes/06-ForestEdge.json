	"raised3": "FF313D27",      // extra small elements
	"surface": "FF252E1D",      // modal surfaces
	"divider": "26EEF2D0",      // thin separator (alpha 0x26)
	"divider2": "33EEF2D0",     // stronger separator (alpha 0x33)
	"veil": "80080A06",         // dim backdrop behind menus (alpha 0x80)
