	"raised": "FF899BB0",       // raised small elements
	"raised2": "FF697D92",      // scrollbar
	"raised3": "FF7B8FA4",      // extra small elements
	"surface": "FF5D7187",      // modal surfaces
	"divider": "26324960",      // thin separator (alpha 0x26)
	"divider2": "33324960",     // stronger separator (alpha 0x33)
	"veil": "80070E1A",         // dim backdrop behind menus (alpha 0x80)
	"text": "FF172331",         // primary text
