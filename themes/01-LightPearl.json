{
  // LightPearl
  "colors": {
    "bg": "FF74747E",           // window + file-list background
    "panel": "FF666670",        // menus, dialogs and panels
    "panel_solid": "F2666670",  // top bar, photo OSD, audio footer
    "panel_solid2": "FC666670", // video OSD sheet
    "row": "FF5C5C66",          // chip / button backgrounds (drive, breadcrumb)
    "zebra": "FF666670",        // list stripe (every other row; == panel_solid)
    "header": "FF50505A",       // top-bar separator + dialog headers
    "raised": "FF484852",       // raised small elements
    "raised2": "FF3E3E48",      // scrollbar
    "raised3": "FF3E3E48",      // extra small elements
    "surface": "FF5E5E68",      // modal surfaces
    "divider": "26020206",      // thin separator (alpha 0x26)
    "divider2": "33020206",     // stronger separator (alpha 0x33)
    "veil": "80020206",         // dim backdrop behind menus (alpha 0x80)
    "text": "FF06060B",         // primary text
    "text2": "FF22222C",        // list / secondary text
    "muted": "FF373741",        // faint text
    "control": "FF8C8C96"       // off/inactive controls (row + one step lighter)
